{
  "name": "dshrsi",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "DSHRSI: Recursive Self-Improvement for DeepSeek Harness. The repository of the dsh-rsi plugin, its tests, benchmarks and website.",
  "license": "MIT",
  "homepage": "https://dshr.si/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qybaihe/dshrsi.git"
  },
  "bugs": "https://github.com/qybaihe/dshrsi/issues",
  "scripts": {
    "test": "node --test --test-timeout=30000 test/unit/ && node --test --test-concurrency=1 --test-timeout=120000 test/e2e/",
    "test:unit": "node --test --test-timeout=30000 test/unit/",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 test/e2e/",
    "test:live": "node test/live/run.mjs",
    "readme:check": "node scripts/readme-languages.mjs --check",
    "rsi": "node packages/dsh-rsi/bin/rsi.js"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "pnpm": "^11.28.11"
  }
}
