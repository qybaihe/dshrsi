{
  "name": "dsh-rsi",
  "version": "0.1.2",
  "description": "DSHRSI: Recursive Self-Improvement for DeepSeek Harness. A plugin through which the harness improves itself around its machine, its user and its project, and builds on each improvement",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-rsi": "bin/rsi.js"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "bin",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "self-improvement",
    "agent-harness"
  ],
  "author": "qybaihe",
  "license": "MIT",
  "homepage": "https://qybaihe.github.io/dshrsi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qybaihe/dshrsi.git",
    "directory": "packages/dsh-rsi"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
